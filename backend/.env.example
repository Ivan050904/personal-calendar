# Database (MySQL 8.x / MariaDB compatible)
DATABASE_URL=mysql+pymysql://calendar:calendar_dev@127.0.0.1:3306/calendar

# App
APP_NAME=personal-calendar-api
APP_ENV=development
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI (optional until Wave 6+) — never commit real keys
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Whisper — production uses Folio AI proxy Groq path (Beget → api.groq.com is 403).
# WHISPER_BACKEND=auto|local|remote  (production always remote)
WHISPER_MODEL=small
WHISPER_BACKEND=remote
WHISPER_API_BASE_URL=http://91.186.214.4:8787/groq/v1
WHISPER_API_KEY=
WHISPER_REMOTE_MODEL=whisper-large-v3-turbo

# Single-user auth (D17) — required for public deploy. Leave empty to disable (local only).
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_SESSION_SECRET=
