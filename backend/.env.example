# Database (MySQL 8.x / MariaDB compatible)
DATABASE_URL=mysql+pymysql://calendar:calendar_dev@127.0.0.1:3306/calendar

# App
APP_NAME=personal-calendar-api
APP_ENV=development
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI (optional until Wave 6+) — never commit real keys
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Whisper — local openai/whisper (GitHub). Benchmarked on RTX 3050: small chosen.
WHISPER_MODEL=small

# Single-user auth (D17) — required for public deploy. Leave empty to disable (local only).
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_SESSION_SECRET=
